# Public site URL (no trailing slash) — used for canonical, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://example.com

# External cannabis menu / ordering platform
NEXT_PUBLIC_MENU_URL=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console site verification meta content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact / careers SMTP (server-only — never prefix with NEXT_PUBLIC_)
# On SiteGround Node apps, localhost:587 often works better than mail.domain.com.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@loldispensary.com
SMTP_PASS=
CONTACT_TO_EMAIL=support@loldispensary.com
CONTACT_FROM_EMAIL=support@loldispensary.com
CAREERS_TO_EMAIL=careers@loldispensary.com
